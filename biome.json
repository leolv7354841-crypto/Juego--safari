{
  "$schema": "https://biomejs.dev/schemas/2.6.2/schema.json",
  "vcs": { "enabled": true, "clientKind": "git", "useIgnoreFile": true },
  "files": {
    "includes": [
      "js/**",
      "!js/vendor",
      "!js/core/version.ts",
      "server/src/**",
      "server/test/**",
      "server/tools/**",
      "test/**",
      "e2e/**",
      "tools/**",
      "*.mjs",
      "*.js"
    ]
  },
  "formatter": { "enabled": true, "indentStyle": "space", "indentWidth": 2, "lineWidth": 120 },
  "javascript": { "formatter": { "quoteStyle": "single", "semicolons": "always", "trailingCommas": "all" } },
  "assist": { "enabled": false },
  "linter": {
    "enabled": true,
    "rules": {
      "preset": "none",
      "correctness": { "noUndeclaredVariables": "off", "noUnusedImports": "warn" },
      "suspicious": { "noDebugger": "error", "noDoubleEquals": "off" }
    }
  }
}
