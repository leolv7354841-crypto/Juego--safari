{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "cleanUrls": true,
  "redirects": [
    { "source": "/", "destination": "/deadzone/", "permanent": false },
    { "source": "/deadzone", "destination": "/deadzone/", "permanent": false }
  ],
  "rewrites": [
    { "source": "/deadzone/", "destination": "/index.html" },
    { "source": "/deadzone/:path+", "destination": "/:path+" }
  ],
  "headers": [
    {
      "source": "/(.*)\\.(js|css)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=0, must-revalidate" }]
    }
  ]
}
