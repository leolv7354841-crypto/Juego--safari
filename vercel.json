{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "installCommand": "npm ci",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "redirects": [
    {
      "source": "/",
      "destination": "/deadzone/",
      "permanent": false
    },
    {
      "source": "/deadzone",
      "destination": "/deadzone/",
      "permanent": false
    },
    {
      "source": "/deadzone/stats/",
      "destination": "/deadzone/stats",
      "permanent": false
    },
    {
      "source": "/stats/",
      "destination": "/stats",
      "permanent": false
    }
  ],
  "rewrites": [
    {
      "source": "/deadzone/",
      "destination": "/index.html"
    },
    {
      "source": "/deadzone/stats",
      "destination": "/stats.html"
    },
    {
      "source": "/stats",
      "destination": "/stats.html"
    },
    {
      "source": "/deadzone/:path+",
      "destination": "/:path+"
    }
  ],
  "headers": [
    {
      "source": "/index.html",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache"
        }
      ]
    },
    {
      "source": "/stats.html",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache"
        },
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        }
      ]
    },
    {
      "source": "/version.json",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache"
        }
      ]
    },
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ]
}
