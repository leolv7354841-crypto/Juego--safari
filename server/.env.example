# Copia de ejemplo de las variables del servidor (no contiene secretos: el servidor no usa ninguno).
# Node no lee este archivo solo: en desarrollo usa `node --env-file=.env src/index.ts`; en la máquina
# virtual van en deploy/.env (ver deploy/README.md).

# Puerto y dirección (Render pone PORT solo; HOST debe ser 0.0.0.0 para aceptar conexiones de fuera)
PORT=2567
HOST=0.0.0.0

# Páginas que pueden conectarse, separadas por comas, sin barra final. Vacío = cualquiera (sólo desarrollo).
# Ejemplo: https://dead-zone.vercel.app,https://raw.githack.com
ALLOWED_ORIGINS=

# Jugadores por sala (máximo 10)
MAX_PLAYERS=4

# Salas a la vez en el servidor; con todas ocupadas, crear otra da «El servidor está lleno»
MAX_ROOMS=5

# Fotos del estado por segundo hacia cada jugador (la simulación va aparte, a NET.tickHz = 60)
SNAP_HZ=20

# Pasos atrasados que se recuperan de una vez tras una pausa del proceso (el resto se descarta)
MAX_CATCHUP=8

# Segundos para volver tras perder la conexión sin perder el sitio ni el personaje
RECONNECT_SECONDS=20

# Una sala sin nadie conectado se borra pasado este tiempo
EMPTY_ROOM_SECONDS=30

# Una sala sin partida (esperando o en resultados) se cierra pasados estos minutos, para que
# una pestaña olvidada no ocupe un cupo de MAX_ROOMS
IDLE_ROOM_MINUTES=20

# Tiempo máximo de carga del mapa antes de empezar igual
LOAD_SECONDS=12

# Sólo para pruebas: simula esta latencia de ida y vuelta (ms)
# COLYSEUS_LATENCY=150
