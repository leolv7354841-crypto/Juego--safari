{
  "name": "dead-zone",
  "version": "1.0.0",
  "private": true,
  "description": "Dead Zone: supervivencia zombi 2D para navegador (Chrome y Safari, computadora y celular).",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "server": "npm start --prefix server",
    "server:install": "npm ci --prefix server",
    "server:test": "npm test --prefix server",
    "server:load": "npm run load --prefix server",
    "test": "node --test test/*.test.js",
    "lint": "biome check .",
    "typecheck": "tsc -p tsconfig.json",
    "format": "biome format --write .",
    "e2e": "vite build && playwright test",
    "build": "vite build",
    "preview": "vite preview"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.2",
    "@playwright/test": "1.64.1",
    "typescript": "5.9",
    "vite": "^8.3.5"
  },
  "dependencies": {
    "@colyseus/sdk": "^0.18.8"
  }
}
