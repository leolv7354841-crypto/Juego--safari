# Ajustes del servidor en la máquina virtual. Copia este archivo a deploy/.env y rellénalo
# (instalar.sh lo hace por ti). Todas las variables están explicadas en server/.env.example.

# Nombre del servidor, apuntando (registro A del DNS) a la IP de la máquina. Sin https://
DOMAIN=servidor.yeyo.games

# Páginas desde las que se juega, separadas por comas, sin barra final ('*' = un trozo del nombre)
ALLOWED_ORIGINS=https://yeyo.games,https://*.yeyo.games,https://deadzone*.vercel.app,https://raw.githack.com

# Capacidad: 4 jugadores por sala y 5 salas a la vez (20 jugadores en total)
MAX_PLAYERS=4
MAX_ROOMS=5

# Fotos por segundo hacia cada jugador (con 2 vCPU sobra para 20)
SNAP_HZ=20

# Una sala sin partida se cierra a los 20 minutos para liberar su cupo
IDLE_ROOM_MINUTES=20
